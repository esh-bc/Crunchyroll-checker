# ============================================
# CRUNCHYBOT - Environment Configuration
# ============================================

# --- Telegram Bot ---
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# --- MongoDB ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/crunchybot
MONGO_DB_NAME=crunchybot

# --- Admin ---
ADMIN_IDS=123456789,987654321

# --- Required Channels (comma-separated chat IDs with -100 prefix) ---
REQUIRED_CHANNELS=-1001234567890,-1009876543210

# --- Bot Settings ---
BOT_USERNAME=@YourCrunchyBot
DEV_CREDIT=@iam_eshh
HEALTH_PORT=8080

# --- Checker Config ---
MAX_CONCURRENT=100
MAX_CONCURRENT_PER_USER=1
REQUEST_TIMEOUT=25
MAX_RETRIES=3
RATE_LIMIT_DELAY=0.3

# --- File Limits ---
MAX_FILE_SIZE=5242880
MAX_COMBO_PER_SESSION_FREE=10000
MAX_COMBO_PER_SESSION_PREMIUM=100000

# --- Proxy Config ---
PROXY_TEST_URL=https://beta-api.crunchyroll.com
PROXY_TEST_TIMEOUT=10
MAX_PROXY_TEST_CONCURRENT=50
